# Dependencies and package-manager caches (keep package manifests/lockfiles).
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Generated builds and tool caches. Native ESM source in src/ must be tracked.
/dist/
/build/
/out/
/release/
/artifacts/
*.tgz
.cache/
.parcel-cache/
.vite/
.eslintcache
*.tsbuildinfo

# Generated test/coverage reports and browser artifacts.
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Only portable regression tests and their shared harness belong in Git.
# Local CDP/smoke scripts use machine-specific hosts, ports and paths.
# This also excludes test JSON, screenshots, logs and validation output.
/tests/*
!/tests/*.test.cjs
!/tests/module-harness.cjs

# Local execution records, not maintained feature/developer documentation.
/docs/*-validation.md

# Local logs, temporary files and machine-specific configuration.
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.env
.env.*
!.env.example
!.env.sample
/.tmp/
/tmp/
/.vscode/
/.idea/
.DS_Store
Thumbs.db
Desktop.ini
